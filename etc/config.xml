<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <default>
        <fastmagentocheckout>
            <general>
                <!--
                    Master switch. 0 = stock Magento checkout (inline config), 1 = deferred async config.
                    Ships DISABLED by default: installing the module must never activate the fast
                    checkout automatically. Turn it on per-environment only after QA passes.
                -->
                <enabled>0</enabled>
                <!--
                    When a guest checks out with an email that already has an account, attach the
                    order to that account. On by default; turn off to keep such orders as guests.
                -->
                <link_guest_orders>1</link_guest_orders>
            </general>
            <address_autocomplete>
                <!--
                    Google Places address autocomplete on the instant form. Enabled by default,
                    but it only activates when a Google Maps API key is resolvable (this module's
                    own key, or the Amasty Address Autocomplete key as a fallback) — with no key
                    the form simply behaves as a plain address form.
                -->
                <enabled>1</enabled>
                <!--
                    NOTE: deliberately no <google_api_key/> default here. An empty self-closing
                    node deserializes to an empty array and clobbers the stored (DB) value during
                    config merge, so scopeConfig would always read null. Omitting it lets the
                    admin-saved key (or the Amasty fallback) resolve correctly.
                -->
            </address_autocomplete>
        </fastmagentocheckout>
    </default>
</config>
